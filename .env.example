# Copy to .env and fill in
OPENAI_API_KEY=sk-change-me
OPENAI_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
DATABASE_URL=postgresql://clientbrain:clientbrain@db:5432/clientbrain
API_PORT=8000
WORKSPACE_DEFAULT=demo
# Auth
MASTER_API_KEY=cb_admin_change-me
# Billing — leave empty for MOCK mode (demo works without keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENABLED=false
# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
